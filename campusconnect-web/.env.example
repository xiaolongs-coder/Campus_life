# ==================== 珠科校园动脉 环境变量模板 ====================
# 复制此文件为 .env.development 或 .env.production 并填入实际值

# 应用名称
VITE_APP_NAME=CampusConnect
VITE_APP_VERSION=1.0.0
VITE_APP_TITLE=珠科校园动脉 (Dev)

# API 配置
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# WebSocket
VITE_WS_URL=ws://localhost:8080/ws

# 文件上传
VITE_UPLOAD_URL=http://localhost:8080/api/upload
VITE_MAX_FILE_SIZE=10485760

# AI 服务 (SiliconFlow)
VITE_AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
VITE_AI_MODEL=THUDM/GLM-4.1V-9B-Thinking
VITE_SILICON_API_KEY=你的SiliconFlow_API_Key

# 分页
VITE_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=50

# 图片上传
VITE_IMAGE_MAX_COUNT=9
VITE_AVATAR_MAX_SIZE=2097152
VITE_COVER_MAX_SIZE=5242880

# 调试
VITE_DEBUG=true
